## Core service host ports
LANDING_HOST_PORT=3030
OO_PORT=3031
FIR_HOST_PORT=3032
GRAFANA_PORT=3033
FAQ_HOST_PORT=3034
ANOMALY_HOST_PORT=3035

## Database (Postgres for core demo)
PGUSER=truststack
PGPASSWORD=truststackpw
PGDATABASE=truststack
PGPORT=5432

## OpenObserve bootstrap
# These credentials will be created on first boot
OO_ROOT_USER_EMAIL=admin@example.com
OO_ROOT_USER_PASSWORD=ChangeMe!123

## Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe!123

## FIR admin/service
FIR_ADMIN_EMAIL=admin@local
FIR_ADMIN_PASSWORD=ChangeMe!123
FIR_SERVICE_TOKEN=changeme

## Anomaly Service
ANOMALY_ADMIN_TOKEN=changeme

## ERP adapter
ERP_URL=
ERP_DEMO_ENABLED=1
ERP_ADAPTER_HOST_PORT=3040
ERP_ADAPTER_MEM_LIMIT=128m
# Must match OpenObserve credentials above
OO_USER=admin@example.com
OO_PASS=ChangeMe!123

## MES profile
# Used only if starting with `docker compose --profile mes up`
ERP_MES_HOST_PORT=3036
ERP_MARIADB_MEM=512m
ERP_REDIS_MEM=128m
# Optional hint for Landing badge (fallback): set to 1 if you know mes is up
MES_PROFILE=0
# Landing internal ping override (defaults to http://erpnext:8080)
ERP_INTERNAL_URL=

## ERP bootstrap
ERP_SITE_NAME=site.local
ERP_DB_ROOT_PASSWORD=erpdbrootpw
ERP_DB_NAME=frappe
ERP_DB_USER=frappe
ERP_DB_PASSWORD=frappepw
ERP_BOOTSTRAP_ADMIN_USER=Administrator
ERP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ERP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

## ERPNext image selection (pinned by default)
ERP_IMAGE_REPO=frappe/erpnext
# Common valid values: v15.17.0, v15.0.0, version-15
ERP_IMAGE_TAG=v15.17.0
# Force amd64 on Apple Silicon (QEMU emulation)
ERP_PLATFORM=linux/amd64


## ERP API
ERP_API_URL=http://localhost:3036
ERP_API_HOST_HEADER=site.local
ERP_API_KEY=
ERP_API_SECRET=

## ERP bridge
ERP_BRIDGE_POLL_MS=15000
# Public host port for ERP Bridge home/health (optional)
ERP_BRIDGE_HOST_PORT=3041
# Memory cap for bridge
ERP_BRIDGE_MEM_LIMIT=256m
# Optional explicit public URL override for Landing "Open" link
# ERP_BRIDGE_URL=http://localhost:3041

## Proof of batch record
PROVE_FIXTURE=fixtures/batch_record.json
